# Copier en `.env` puis remplacer les valeurs marquées CHANGEZ-MOI.
#   cp .env.example .env
#
# Ce fichier est versionné et ne doit contenir AUCUN secret réel.
# `.env` est ignoré par git.

# ---------------------------------------------------------------------------
# Projet
# ---------------------------------------------------------------------------
# Fige le nom de projet Compose. Sans cela, Compose le dérive du nom du
# répertoire en le passant en minuscules et en retirant les caractères non
# alphanumériques : « projet_fin_année » deviendrait « projet_fin_anne »,
# silencieusement, dans les noms de conteneurs, volumes et réseaux.
COMPOSE_PROJECT_NAME=entretiens

ENVIRONNEMENT=development
NIVEAU_LOG=INFO

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=entretiens
POSTGRES_USER=entretiens
POSTGRES_PASSWORD=CHANGEZ-MOI-mot-de-passe-base

# ---------------------------------------------------------------------------
# Redis — rate limiting uniquement, aucune donnée RH n'y transite (§6.3)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGEZ-MOI-mot-de-passe-redis

# ---------------------------------------------------------------------------
# Sécurité applicative
# ---------------------------------------------------------------------------
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGEZ-MOI-cle-de-signature-jwt-au-moins-32-caracteres
DUREE_JETON_MINUTES=60

# Origines autorisées par CORS, séparées par des virgules. Jamais "*".
ORIGINES_CORS=http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------------------
# Ports publiés sur l'hôte — surcharge de développement uniquement
# ---------------------------------------------------------------------------
PORT_API=8000
PORT_WEB=8080
PORT_WEB_DEV=5173
PORT_DB=5432
PORT_REDIS=6379

# ---------------------------------------------------------------------------
# Images et tag — compose.prod.yml uniquement
# ---------------------------------------------------------------------------
# ⚠️ TAG, BACKEND_IMAGE et FRONTEND_IMAGE sont volontairement ABSENTS de ce
# fichier. En développement, compose.yml applique le défaut `${TAG:-dev}`. En
# production, compose.prod.yml exige `${TAG:?}` et refuse de démarrer sans lui.
#
# Les définir ici les rendrait disponibles partout, y compris sur le serveur de
# production si quelqu'un y copiait ce fichier : le garde-fou « jamais latest »
# (§10.1) serait alors silencieusement neutralisé et l'image `dev` déployée.
#
# Le pipeline les injecte au moment du déploiement :
#   export TAG=$GITHUB_SHA
#   export BACKEND_IMAGE=ghcr.io/<org>/<repo>/backend
